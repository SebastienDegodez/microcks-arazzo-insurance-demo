{
  "Urls": "http://localhost:5180",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Services": {
    "CustomerAccounts": "http://localhost:8080/rest/Customer+accounts/1.0.0/",
    "Sirene": "http://localhost:8080/rest/Sirene/1.0.0/",
    "Bodacc": "http://localhost:8080/rest/BODACC/1.0.0/",
    "CompanyFinancials": "http://localhost:8080/rest/Company+financials/1.0.0/",
    "ClaimsAndContracts": "http://localhost:8080/rest/Claims+and+contracts/1.0.0/"
  },

  "Mcp": {
    "Georisques": {
      // reShapr exposes Géorisques as MCP, with Microcks simulating the API behind it.
      // Microcks' native MCP server also works: http://localhost:8080/mcp/Georisques/1.0.0
      "Endpoint": "http://localhost:7778/mcp/reshapr/georisques-1-0-0-default"
    }
  },

  "LlmGateway": {
    "BaseUrl": "http://localhost:8080/rest/LLM+gateway/1.0.0/",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "SendMetadata": true,
    "TimeoutSeconds": 120,
    "DelayOverrides": {
      "financial-health": { "Delay": 50000, "Strategy": "random-20" }
    }
  },

  "Llm": {
    "MaxConcurrency": 2
  },

  "Orchestration": {
    "StartJitterMilliseconds": { "Min": 300, "Max": 5000 },
    "ServiceDelayMilliseconds": { "Min": 0, "Max": 0 },
    "LlmDelayMilliseconds": { "Min": 0, "Max": 0 }
  },

  "Demo": {
    "MicrocksDelayOverride": {}
  }
}
