{
  "Urls": "http://localhost:5180",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Services": {
    "CustomerAccounts": "http://localhost:8080/rest/Customer+accounts/1.0.0/",
    "Sirene": "http://localhost:8080/rest/Sirene/1.0.0/",
    "Bodacc": "http://localhost:8080/rest/BODACC/1.0.0/",
    "CompanyFinancials": "http://localhost:8080/rest/Company+financials/1.0.0/",
    "ClaimsAndContracts": "http://localhost:8080/rest/Claims+and+contracts/1.0.0/"
  },

  "Mcp": {
    // Climate agent, example 2: reShapr exposes Géorisques and BODACC as MCP, Microcks simulates the APIs behind it.
    // Microcks' native MCP servers also work: http://localhost:8080/mcp/Georisques/1.0.0, .../mcp/BODACC/1.0.0
    "Georisques": "http://localhost:7778/mcp/reshapr/georisques-1-0-0-default",
    "Bodacc": "http://localhost:7778/mcp/reshapr/bodacc-1-0-0-default",
    // Financial-health agent, example 1 ("pure Microcks"): the native MCP endpoint of the Company financials mock.
    "CompanyFinancials": "http://localhost:8080/mcp/Company%20financials/1.0.0"
  },

  "LlmGateway": {
    "BaseUrl": "http://localhost:8080/rest/LLM+gateway/1.0.0/",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "SendMetadata": true,
    "TimeoutSeconds": 120,
    // Per-agent latency of the Microcks LLM mock, e.g. "financial-health": { "Delay": 50000, "Strategy": "random-20" }
    "DelayOverrides": {}
  },

  "Llm": {
    "MaxConcurrency": 2
  },

  "Orchestration": {
    "StartJitterMilliseconds": { "Min": 300, "Max": 5000 },
    "ServiceDelayMilliseconds": { "Min": 0, "Max": 0 },
    "LlmDelayMilliseconds": { "Min": 0, "Max": 0 }
  },

  "Demo": {
    "MicrocksDelayOverride": {}
  }
}
